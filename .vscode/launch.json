{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ancillary ServiceHost (debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-servicehost",
      "program": "${workspaceFolder}/src/AeroTech.Ancillary.ServiceHost/bin/Debug/net10.0/AeroTech.Ancillary.ServiceHost.dll",
      "cwd": "${workspaceFolder}/src/AeroTech.Ancillary.ServiceHost",
      "console": "internalConsole",
      "stopAtEntry": false,
      "requireExactSource": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:4046",
        "DOTNET_MODIFIABLE_ASSEMBLIES": ""
      }
    },
    {
      "name": "Ancillary ServiceHost (attach)",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
