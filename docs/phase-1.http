  "codes": { "serviceTypeCode": "C" },
  "terms": { "refundable": false, "commissionable": null, "reusable": null, "formOfRefundCode": null, "interlineSettlementAllowed": null },
  "inventoryControl": "Unlimited",
  "baggage": { "pieces": 1, "weight": 23, "weightUnit": "Kg" }
}

### 11. Define the generic extra-bag product on XBG, quantity 1–2 — expect 200, status "Draft"
# @name defineGeneric
POST {{host}}/Backoffice/v1/AncillaryProducts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "XBAGG",
  "type": "ExtraBaggage",
  "name": "Extra bag 23kg",
  "description": null,
  "salesScope": "TravellerBound",
  "quantity": { "unit": "Piece", "min": 1, "max": 2 },
  "document": { "type": "EmdAssociated", "rfisc": "XBG" },
  "codes": { "serviceTypeCode": "C" },
  "terms": { "refundable": false, "commissionable": null, "reusable": null, "formOfRefundCode": null, "interlineSettlementAllowed": null },
  "inventoryControl": "Unlimited",
  "baggage": { "pieces": 1, "weight": 23, "weightUnit": "Kg" }
}

### 12. Quote while both products are still Draft — expect 200 with "items": []
POST {{host}}/Service/v1/AncillaryQuotes
Content-Type: application/json

{
  "currencyId": {{currencyId}},
  "asOf": "2026-10-01T14:00:00+00:00",
  "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1"] } ],
  "bounds": [ { "ref": "B1", "flights": [
    { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
      "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ]
}

### 13. Activate the first-bag product — expect 200, status "Active"
POST {{host}}/Backoffice/v1/AncillaryProducts/{{defineProduct.response.body.data.id}}/Activate
Authorization: Bearer {{token}}

### 14. Define the price rule for XBAG1 (price 35.00 + tax 3.50) — expect 200, status "Draft"
# @name defineRule
POST {{host}}/Backoffice/v1/AncillaryPriceRules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "XBAG1",
  "priority": 1,
  "currencyId": {{currencyId}},
  "lines": [
    { "category": "Ancillary", "code": null, "name": null, "amount": 35.00 },
    { "category": "Tax", "code": "VAT", "name": "Value added tax", "amount": 3.50 }
  ],
  "salesFrom": null, "salesTo": null, "travelFrom": null, "travelTo": null,
  "conditions": { "passengerTypes": null, "originAirportIds": null, "destinationAirportIds": null }
}

### 15. A rule for a product that does not exist — expect 422, code 16205
POST {{host}}/Backoffice/v1/AncillaryPriceRules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "NOSUCH",
  "priority": 1,
  "currencyId": {{currencyId}},
  "lines": [ { "category": "Ancillary", "code": null, "name": null, "amount": 35.00 } ],
  "salesFrom": null, "salesTo": null, "travelFrom": null, "travelTo": null,
  "conditions": { "passengerTypes": null, "originAirportIds": null, "destinationAirportIds": null }
}

### 16. Activate the rule — expect 200, status "Active"
POST {{host}}/Backoffice/v1/AncillaryPriceRules/{{defineRule.response.body.data.id}}/Activate
Authorization: Bearer {{token}}

### 17. Quote, catalogue mode, two travellers and a two-flight bound
### (T1 flies F1 and F2; T2 flies only F2)
### Expect 200 and exactly ONE item, XBAG1 for T2/B1 with coveredFlightRefs ["F2"].
### T1 gets no item: a bag is offered only where the traveller flies exactly one flight of the bound.
###   The item: quantity 1, minQuantity 1, maxQuantity 1, productVersion 1, priceRuleId = the rule of request 14,
###   codes {serviceTypeCode "C", groupCode "BG", subGroupCode null, description1Code "B1", description2Code null},
###   document {type "EmdAssociated", rfic "C", rfisc "0CC"},
###   priceLines [Ancillary 35.00, Tax VAT 3.50], unitTotal 38.50, total 38.50,
###   inventory {control "Unlimited", remaining null}
POST {{host}}/Service/v1/AncillaryQuotes
Content-Type: application/json

{
  "currencyId": {{currencyId}},
  "asOf": "2026-10-01T14:00:00+00:00",
  "salesContext": { "channel": "BackOffice", "customerId": null, "travelAgencyId": null, "countryId": null },
  "travellers": [
    { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1", "F2"] },
    { "ref": "T2", "passengerTypeCode": "CHD", "flightRefs": ["F2"] } ],
  "bounds": [ { "ref": "B1", "flights": [
    { "ref": "F1", "flightId": "100", "flightCapacityId": "5001", "originAirportId": 1, "destinationAirportId": 2,
      "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}},
      "aircraftId": 7, "cabinClassId": 2, "rbdId": "5" },
    { "ref": "F2", "flightId": "101", "flightCapacityId": "5002", "originAirportId": 2, "destinationAirportId": 3,
      "departureDateTime": "2026-10-10T12:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}},
      "aircraftId": 7, "cabinClassId": 2, "rbdId": "5" } ] } ]
}

### 18. Quote, selection mode — the golden example of the phase document
### Expect 200, one item: quantity 1, priceLines amounts 35.00 and 3.50, unitTotal 38.50, total 38.50
POST {{host}}/Service/v1/AncillaryQuotes
Content-Type: application/json

{
  "currencyId": {{currencyId}},
  "asOf": "2026-10-01T14:00:00+00:00",
  "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1"] } ],
  "bounds": [ { "ref": "B1", "flights": [
    { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
      "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ],
  "selections": [ { "productRef": "XBAG1", "productVersion": 1, "priceRuleId": "{{defineRule.response.body.data.id}}", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 } ]
}

