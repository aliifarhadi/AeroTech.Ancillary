      "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ],
  "existing": [ { "productRef": "XBAG1", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 } ],
  "selections": [ { "productRef": "XBAG1", "productVersion": 1, "priceRuleId": "{{defineRule.response.body.data.id}}", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 } ]
}

### 24. Revise the product — expect 200, a new Draft with version 2
# @name reviseProduct
POST {{host}}/Backoffice/v1/AncillaryProducts/{{defineProduct.response.body.data.id}}/Revise
Authorization: Bearer {{token}}

### 25. Activate version 2 — expect 200, status "Active", retiredVersionId = id of version 1
POST {{host}}/Backoffice/v1/AncillaryProducts/{{reviseProduct.response.body.data.id}}/Activate
Authorization: Bearer {{token}}

### 26. Repeat request 18 unchanged (it still says "productVersion": 1) — expect 409, code 16309.
###     Then send it with "productVersion": 2 — expect 200 with the same prices.

### 27. Change version 1 (now Retired) — expect 409, code 16103
PUT {{host}}/Backoffice/v1/AncillaryProducts/{{defineProduct.response.body.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Should not change",
  "description": null,
  "salesScope": "TravellerBound",
  "quantity": { "unit": "Piece", "min": 1, "max": 1 },
  "document": { "type": "EmdAssociated", "rfisc": "0CC" },
  "codes": { "serviceTypeCode": "C" },
  "terms": { "refundable": false, "commissionable": null, "reusable": null, "formOfRefundCode": null, "interlineSettlementAllowed": null },
  "inventoryControl": "Unlimited",
  "baggage": { "pieces": 1, "weight": 23, "weightUnit": "Kg" }
}

### 28. Retire the sub code 0CC — expect 200, status "Retired".
###     Then repeat request 17 — the Active product is still offered, unchanged.
POST {{host}}/Backoffice/v1/ServiceSubCodes/{{subCode.response.body.data.id}}/Retire
Authorization: Bearer {{token}}

### 29. Reactivate it — expect 200, status "Active"; request 2 returns exactly the same attributes as before
POST {{host}}/Backoffice/v1/ServiceSubCodes/{{subCode.response.body.data.id}}/Reactivate
Authorization: Bearer {{token}}

### 30. A value that does not exist in Phase 1 — expect 400
POST {{host}}/Backoffice/v1/AncillaryProducts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "LNG01",
  "type": "LoungeAccess",
  "name": "Lounge",
  "description": null,
  "salesScope": "TravellerSegment",
  "quantity": { "unit": "Each", "min": 1, "max": 1 },
  "document": { "type": "EmdStandalone", "rfisc": "0BX" },
  "codes": { "serviceTypeCode": "F" },
  "terms": { "refundable": false, "commissionable": null, "reusable": null, "formOfRefundCode": null, "interlineSettlementAllowed": null },
  "inventoryControl": "Unlimited",
  "baggage": null
}
