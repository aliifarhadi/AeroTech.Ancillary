### Phase 2B proof — run top to bottom against the local development database.
### Format: VS Code "REST Client" / Visual Studio / JetBrains HTTP client.
###
### Before running:
###   - @token      : a Backoffice JWT for the development environment.
###   - @airlineId  : the id of a selling airline that has NO Ancillary data yet.
###   - @currencyId : the id of the currency to price in.
###   - @future     : a moment a few hours from now;  @past : a moment already gone.
### Amounts are test data.

@host = http://localhost:4046
@token = PUT-A-BACKOFFICE-TOKEN-HERE
@airlineId = 12
@currencyId = 978
@future = 2027-01-01T00:00:00+00:00
@past = 2020-01-01T00:00:00+00:00

### 1. Enable 0CC — expect 200
POST {{host}}/Backoffice/v1/ServiceSubCodes
Authorization: Bearer {{token}}
Content-Type: application/json

{ "ownerAirlineId": {{airlineId}}, "code": "0CC" }

### 2. Define the bag XBAG1 — expect 200, "Draft"
# @name bag
POST {{host}}/Backoffice/v1/AncillaryProducts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "XBAG1",
  "type": "ExtraBaggage",
  "name": "First extra bag 23kg",
  "description": null,
  "salesScope": "TravellerBound",
  "quantity": { "unit": "Piece", "min": 1, "max": 1 },
  "document": { "type": "EmdAssociated", "rfisc": "0CC" },
  "codes": { "serviceTypeCode": "C" },
  "terms": { "refundable": false, "commissionable": null, "reusable": null, "formOfRefundCode": null, "interlineSettlementAllowed": null },
  "inventoryControl": "Unlimited",
  "baggage": { "pieces": 1, "weight": 23, "weightUnit": "Kg" },
  "lounge": null
}

### 3. Activate it — expect 200, "Active"
POST {{host}}/Backoffice/v1/AncillaryProducts/{{bag.response.body.data.id}}/Activate
Authorization: Bearer {{token}}

### 4. Define its rule (35.00 + VAT 3.50) — expect 200, "Draft"
# @name rule
POST {{host}}/Backoffice/v1/AncillaryPriceRules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerAirlineId": {{airlineId}},
  "productRef": "XBAG1",
  "priority": 1,
  "currencyId": {{currencyId}},
  "lines": [
    { "category": "Ancillary", "code": null, "name": null, "amount": 35.00 },
    { "category": "Tax", "code": "VAT", "name": "Value added tax", "amount": 3.50 }
  ],
  "salesFrom": null, "salesTo": null, "travelFrom": null, "travelTo": null,
  "conditions": { "passengerTypes": null, "originAirportIds": null, "destinationAirportIds": null }
}

### 5. Activate it — expect 200, "Active"
POST {{host}}/Backoffice/v1/AncillaryPriceRules/{{rule.response.body.data.id}}/Activate
Authorization: Bearer {{token}}

### 6. Reserve the bag — expect 200: one unit "Held", total 38.50, coveredFlightIds ["100"],
###    inventoryControl "Unlimited", productVersion 1, priceRuleId = the rule of request 4
# @name hold
POST {{host}}/Service/v1/ServiceReservations
Content-Type: application/json

{
  "idempotencyKey": "proof-2b-1",
  "reference": "proof-order-1",
  "expiresAt": "{{future}}",
  "context": {
    "currencyId": {{currencyId}},
    "asOf": "{{$datetime iso8601}}",
    "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1"] } ],
    "bounds": [ { "ref": "B1", "flights": [
      { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
        "departureDateTime": "2027-01-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ],
    "existing": []
  },
  "units": [
    { "unitReference": "U1", "productRef": "XBAG1", "productVersion": 1, "priceRuleId": "{{rule.response.body.data.id}}", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 }
  ]
}

### 7. The same request again — expect 200 with the same reservationId and unitRef
POST {{host}}/Service/v1/ServiceReservations
Content-Type: application/json

{
  "idempotencyKey": "proof-2b-1",
  "reference": "proof-order-1",
  "expiresAt": "{{future}}",
  "context": {
    "currencyId": {{currencyId}},
    "asOf": "{{$datetime iso8601}}",
    "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1"] } ],
    "bounds": [ { "ref": "B1", "flights": [
      { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
        "departureDateTime": "2027-01-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ],
    "existing": []
  },
  "units": [
    { "unitReference": "U1", "productRef": "XBAG1", "productVersion": 1, "priceRuleId": "{{rule.response.body.data.id}}", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 }
  ]
}

