    { "unitReference": "U1", "productRef": "XBAG1", "productVersion": 2, "priceRuleId": "{{rule.response.body.data.id}}", "travellerRef": "T1", "boundRef": "B1", "flightRef": null, "quantity": 1 }
  ]
}

