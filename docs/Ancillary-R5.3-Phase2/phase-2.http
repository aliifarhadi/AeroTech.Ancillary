Authorization: Bearer {{token}}

### 21. Catalogue — the golden example of the phase document.
### Expect 200 and exactly three items in this order:
###   XBAG1 T1/B1 (flightRef null, coveredFlightRefs ["F1"], lounge null, total 35.00);
###   LNGTHR T1/B1/F1 (salesScope TravellerSegment, flightRef "F1", coveredFlightRefs ["F1"], unit "Each",
###     document {type EmdStandalone, rfic E, rfisc 0BX}, codes.groupCode LG, lounge {airportIds [1]},
###     baggage null, total 20.00);
###   XBAG1 T1/B2 (coveredFlightRefs ["F2"], total 35.00).
### No lounge item for F2 (it departs airport 2).
POST {{host}}/Service/v1/AncillaryQuotes
Content-Type: application/json

{
  "currencyId": {{currencyId}},
  "asOf": "2026-10-01T14:00:00+00:00",
  "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1", "F2"] } ],
  "bounds": [
    { "ref": "B1", "flights": [
      { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
        "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] },
    { "ref": "B2", "flights": [
      { "ref": "F2", "flightId": "101", "originAirportId": 2, "destinationAirportId": 1,
        "departureDateTime": "2026-10-15T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ]
}

### 22. Select the lounge for F1 without boundRef — expect 200, one item, boundRef "B1", total 20.00
POST {{host}}/Service/v1/AncillaryQuotes
Content-Type: application/json

{
  "currencyId": {{currencyId}},
  "asOf": "2026-10-01T14:00:00+00:00",
  "travellers": [ { "ref": "T1", "passengerTypeCode": "ADT", "flightRefs": ["F1", "F2"] } ],
  "bounds": [
    { "ref": "B1", "flights": [
      { "ref": "F1", "flightId": "100", "originAirportId": 1, "destinationAirportId": 2,
        "departureDateTime": "2026-10-10T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] },
    { "ref": "B2", "flights": [
      { "ref": "F2", "flightId": "101", "originAirportId": 2, "destinationAirportId": 1,
        "departureDateTime": "2026-10-15T08:00:00+03:30", "marketingAirlineId": {{airlineId}}, "operatingAirlineId": {{airlineId}} } ] } ],
  "selections": [ { "productRef": "LNGTHR", "productVersion": 1, "priceRuleId": "{{loungeRule.response.body.data.id}}", "travellerRef": "T1", "boundRef": null, "flightRef": "F1", "quantity": 1 } ]
}

