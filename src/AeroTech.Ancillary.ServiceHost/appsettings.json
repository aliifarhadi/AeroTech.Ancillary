{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "IdGenerator": {
    "GeneratorId": 0
  },
  "Shopping": {
    "SourceContextTtl": "01:00:00",
    "SelectionMaxAge": "00:30:00"
  },
  "Holds": {
    "LockExpirySeconds": 60,
    "ExpiryPollIntervalSeconds": 120,
    "ExpiryBatchSize": 200
  },
  "AllowedHosts": "*"
}
